{
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/whatsapp/process-sales",
      "schedule": "*/5 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/e/:id",
      "destination": "/api/share?event=:id"
    },
    {
      "source": "/g/:id",
      "destination": "/api/share?game=:id"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(.*)\\.vercel\\.app"
        }
      ],
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "vercel-cron/1.0"
        }
      ],
      "destination": "https://glass-wings.com/:path*",
      "permanent": true
    }
  ]
}
